{
  "name": "saucedemo-automacao-qa",
  "version": "1.0.0",
  "description": "Automação de testes E2E com Playwright para o Sauce Demo (login e carrinho)",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:login": "playwright test tests/login.spec.js",
    "test:carrinho": "playwright test tests/carrinho.spec.js",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "report": "playwright show-report"
  },
  "author": "Vinicius Claret",
  "devDependencies": {
    "@playwright/test": "^1.50.0"
  }
}
